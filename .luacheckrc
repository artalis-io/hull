globals = { "app", "db", "time", "json", "crypto", "log", "env", "fs", "tool", "test", "http", "smtp", "hull", "worker", "server", "compute", "gpu", "__hull_exe", "_template" }
std = "lua54"
exclude_files = { "stdlib/lua/vendor/", "vendor/" }
