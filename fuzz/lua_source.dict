# libFuzzer dictionary for the Lua 5.4 source parser (hull.source.lua).
# Keywords, operators, and the lexer/parser/annotation edge tokens, so the mutator
# reaches deep constructs quickly. Format: name="token".

# keywords
kw_and="and"
kw_break="break"
kw_do="do"
kw_else="else"
kw_elseif="elseif"
kw_end="end"
kw_false="false"
kw_for="for"
kw_function="function"
kw_goto="goto"
kw_if="if"
kw_in="in"
kw_local="local"
kw_nil="nil"
kw_not="not"
kw_or="or"
kw_repeat="repeat"
kw_return="return"
kw_then="then"
kw_true="true"
kw_until="until"
kw_while="while"

# operators / punctuation
op_concat=".."
op_ellipsis="..."
op_eq="=="
op_ne="~="
op_le="<="
op_ge=">="
op_shl="<<"
op_shr=">>"
op_idiv="//"
op_label="::"
op_assign="="
op_index_l="["
op_index_r="]"
op_call_l="("
op_call_r=")"
op_tbl_l="{"
op_tbl_r="}"
op_len="#"

# lexer edge forms
long_open="[["
long_open2="[==["
long_close="]==]"
comment="--"
doc_comment="---"
hex="0x"
hexfloat="0x1.8p3"
esc_x="\\x41"
esc_u="\\u{1F600}"
esc_z="\\z"
shebang="#!/usr/bin/env hull"

# attributes + annotations (Hull-owned)
attr_const="<const>"
attr_close="<close>"
annot="---@"
annot_compute="---@compute"
annot_param="---@param x f64"
