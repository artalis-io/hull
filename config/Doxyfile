# Doxygen config for Hull's public C API (`include/hull/`).
# Output: build/api/c/

PROJECT_NAME           = "Hull C API"
PROJECT_BRIEF          = "Capability-secure web runtime — public C surface"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = build/api/c

# What to scan
INPUT                  = include/hull
RECURSIVE              = YES
FILE_PATTERNS          = *.h
EXCLUDE_PATTERNS       = */internal*

# Strip include path so symbols read as `hull/cap/db.h::hl_cap_db_query`
# rather than the full absolute path.
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include

# What to extract
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INLINE_INHERITED_MEMB  = YES

# Output format
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
HTML_OUTPUT            = .
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_MENUS     = YES
SEARCHENGINE           = YES

# Aesthetics
SHOW_INCLUDE_FILES     = YES
SHOW_NAMESPACES        = YES
ALPHABETICAL_INDEX     = YES
SORT_BY_SCOPE_NAME     = YES
SORT_MEMBER_DOCS       = NO   # preserve declaration order — easier to follow
JAVADOC_AUTOBRIEF      = YES  # treat first line of /** ... */ as @brief
MULTILINE_CPP_IS_BRIEF = NO

# Diagnostics
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO   # set to YES after the annotation pass completes

# Preprocessor
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = HL_ENABLE_DB \
                         HL_ENABLE_WASM \
                         HL_ENABLE_GPU \
                         HL_ENABLE_LUA \
                         HL_ENABLE_JS \
                         HL_ENABLE_TCC \
                         HL_EMBED_CA_BUNDLE

# Source browser (linked from each symbol)
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# Disable noisy / unused
HAVE_DOT               = NO
# CLASS_DIAGRAMS removed in newer Doxygen — handled via CLASS_GRAPH=NO instead
