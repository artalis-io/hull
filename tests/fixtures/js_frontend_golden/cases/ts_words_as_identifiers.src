// TypeScript's contextual keywords are ordinary identifiers in JavaScript.
const type = 1, as = 2, satisfies = 3, declare = 4, namespace = 5, module = 6;
let abstract = 7, readonly = 8, override = 9, infer = 10, keyof = 11, is = 12, asserts = 13;
var unique = 14, global = 15, accessor = 16, out = 17, of = 18, get = 19, set = 20;
function interface_like(type, as, declare) { return type + as + declare; }
const o = { type, as, declare, namespace: 1, abstract() { return 1; }, get readonly() { return 2; } };
o.type = o.as + satisfies;
type: for (;;) { break type; }
export { type, as, satisfies };
