#compdef hull
# Hull - zsh completion
#
# Install:
#   # System-wide (Homebrew on macOS):
#   cp _hull "$(brew --prefix)/share/zsh/site-functions/_hull"
#   # User-local:
#   mkdir -p ~/.zsh/completions
#   cp _hull ~/.zsh/completions/_hull
#   # Then add to ~/.zshrc:
#   fpath=(~/.zsh/completions $fpath)
#   autoload -Uz compinit && compinit
#
# SPDX-License-Identifier: AGPL-3.0-or-later

_hull() {
    local -a commands agent_subs agent_db_subs migrate_subs deploy_targets runtimes compilers
    commands=(
        'keygen:Generate Ed25519 keypair'
        'build:Compile app into a standalone binary'
        'verify:Verify Ed25519 signatures and file integrity'
        'verify-self:Verify this hull binary against its signed release manifest'
        'verify-release:Verify a release manifest signature (offline audit)'
        'sign-release:Sign a release manifest with the Ed25519 release key (CI)'
        'sbom:Print Software Bill of Materials (human/json/cyclonedx/spdx)'
        'inspect:Display declared capabilities and signature status'
        'manifest:Extract and print manifest as JSON'
        'test:Run app tests (in-process, in-memory SQLite)'
        'new:Scaffold a new hull project in a new directory'
        'init:Initialize hull in the current directory (idempotent)'
        'dev:Run the development server with hot reload'
        'eject:Export to a standalone Makefile project'
        'sign-platform:Sign platform library with per-arch hashes'
        'migrate:Run SQL migrations'
        'modules:Inspect first-party module registry and app declarations'
        'agent:Machine-readable introspection for AI coding agents'
        'mcp:Model Context Protocol server'
        'check:Pre-flight checks on a hull project'
        'compute:WASM compute plugin tools'
        'deploy:Generate deployment configs (Dockerfile, systemd, fly.toml)'
        'version:Print hull version'
        'doctor:Check environment for hull build readiness'
        'update:Self-update from GitHub releases'
        'tools:Install / list / uninstall side-loaded tools (e.g. wamrc)'
        'help:Show top-level usage'
    )
    local -a modules_subs sbom_formats
    modules_subs=(
        'list:Print modules an app declares'
        'available:Print the full first-party module registry'
        'explain:Print the spec for one module'
        'analyze:Walk source for undeclared imports / unused declarations'
    )
    sbom_formats=('human' 'json' 'cyclonedx' 'spdx')
    local -a tools_subs
    tools_subs=(
        'list:Print the registry + install state'
        'install:Download, verify, install a tool'
        'uninstall:Remove an installed tool'
    )
    # Keep in sync with src/hull/commands/agent.c hl_cmd_agent() dispatch table.
    agent_subs=(
        'routes:List routes + middleware'
        'db:Database introspection (schema/query)'
        'request:HTTP request to dev server'
        'status:Check dev server status'
        'errors:Structured errors from last reload'
        'test:Run tests with JSON output'
        'context:Task-relevant documentation'
        'migrate:Migration status'
        'deploy:Deployment readiness analysis'
        'manifest:Manifest as structured JSON'
        'vfs:List embedded VFS entries'
        'compute:WASM compute module inventory'
        'compute-call:Invoke a WASM compute module with a JSON input'
        'gpu:GPU device + shader inventory'
        'capabilities:Resolved capability surface (manifest + defaults)'
        'validate:Validate a request/response/config file against a schema'
        'logs:Tail recent dev-server logs as JSON'
        'endpoint:Describe a single route in detail'
        'middleware:Enumerate registered middleware'
        'eval:Evaluate a Lua/JS expression in the app sandbox'
        'perf:Per-request performance snapshot'
        'template:Render a template with sample data'
        'schema-diff:Diff applied schema vs migration files'
        'sql:Run a read-only SQL query against the app DB'
        'tools:Side-loaded tool registry + install state'
        'overview:Single-shot project summary'
    )
    # Keep in sync with stdlib/context/*.md filenames.
    local -a agent_context_tasks
    agent_context_tasks=(
        'auth' 'build' 'compute' 'db' 'deploy' 'gpu' 'i18n' 'middleware'
        'orientation' 'quickstart-cli' 'quickstart-tui' 'quickstart-web'
        'routing' 'search' 'templates' 'testing' 'tools' 'validation' 'webhooks'
    )
    agent_db_subs=(
        'schema:Introspect DB schema'
        'query:Run read-only SQL query'
    )
    migrate_subs=(
        'status:Show migration status (applied/pending)'
        'new:Create a new numbered migration file'
    )
    deploy_targets=(
        'dockerfile:Generate Dockerfile + .dockerignore'
        'systemd:Generate systemd service unit + install.sh'
        'fly:Generate fly.toml'
    )
    runtimes=('lua' 'js')
    compilers=('tcc' 'system' 'cc' 'gcc' 'clang' 'cosmocc')

    _arguments -C \
        '(-v --version)'{-v,--version}'[Print hull version]' \
        '1: :->command' \
        '*:: :->args' \
        && return 0

    case $state in
        command)
            _describe -t commands 'hull command' commands
            ;;

        args)
            case "$words[1]" in
                build)
                    _arguments \
                        '(-o --output)'{-o,--output}'[Output binary path]:file:_files' \
                        '--compiler[C compiler backend]:compiler:('"${compilers[@]}"')' \
                        '--compiler=[C compiler backend]:compiler:('"${compilers[@]}"')' \
                        '--runtime[Runtime to use]:runtime:('"${runtimes[@]}"')' \
                        '--target[Cross-compile target]:arch:(x86_64 aarch64)' \
                        '--sign[Signing key file]:file:_files' \
                        '--developer-key[Developer public key]:file:_files' \
                        '--no-aot[Skip AOT compilation of WASM modules]' \
                        '*:app dir:_files -/'
                    ;;

                dev)
                    _arguments \
                        '(-p --port)'{-p,--port}'[Listen port]:port:' \
                        '(-d --database)'{-d,--database}'[Database file]:file:_files' \
                        '--agent[Enable agent sidecar files]' \
                        '--no-migrate[Skip auto-run migrations on startup]' \
                        '--no-sandbox[Disable kernel sandbox]' \
                        '--audit[Enable capability audit logging]' \
                        '--ca-bundle[Custom CA bundle path]:file:_files' \
                        '--ca-bundle=[Custom CA bundle path]:file:_files' \
                        '--no-ca-bundle[Skip TLS verification (dev only)]' \
                        '*:entry point:_files'
                    ;;

                test|check|inspect|verify|manifest|eject)
                    _arguments \
                        '--json[Machine-readable JSON output]' \
                        '--developer-key[Developer public key]:file:_files' \
                        '*:app dir:_files -/'
                    ;;

                compute)
                    # hull compute <subcmd> [args]
                    local -a compute_subs
                    compute_subs=(
                        'new:Create a new WASM compute module skeleton'
                        'build:Compile compute/<name>/<name>.c -> compute/<name>.wasm'
                        'test:Run test fixtures against a compute module'
                        'check:Validate a .wasm module loads correctly in WAMR'
                        'refresh-header:Update per-module hull_compute.h from canonical version'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t compute-subs 'compute subcommand' compute_subs
                    else
                        case "$words[2]" in
                            new)
                                _arguments \
                                    '--lang[Source language]:lang:(c)' \
                                    '*:module name:'
                                ;;
                            build|test|check|refresh-header)
                                # Complete with discovered module names.
                                local -a mods
                                if [[ -d compute ]]; then
                                    mods=(${(f)"$(print -l compute/*/*.c(N:h:t) 2>/dev/null)"})
                                fi
                                _arguments "*:module:($mods)"
                                ;;
                        esac
                    fi
                    ;;

                new)
                    _arguments \
                        '--runtime[Runtime]:runtime:('"${runtimes[@]}"')' \
                        '--runtime=[Runtime]:runtime:('"${runtimes[@]}"')' \
                        '*:dir:_files -/'
                    ;;

                init)
                    _arguments \
                        '--runtime[Runtime]:runtime:('"${runtimes[@]}"')' \
                        '--runtime=[Runtime]:runtime:('"${runtimes[@]}"')' \
                        '*:dir:_files -/'
                    ;;

                agent)
                    if (( CURRENT == 2 )); then
                        _describe -t agent-subs 'agent subcommand' agent_subs
                    else
                        case "$words[2]" in
                            db)
                                if (( CURRENT == 3 )); then
                                    _describe -t agent-db-subs 'db subcommand' agent_db_subs
                                else
                                    _files -/
                                fi
                                ;;
                            request)
                                if (( CURRENT == 3 )); then
                                    _values 'HTTP method' GET POST PUT PATCH DELETE HEAD OPTIONS
                                fi
                                ;;
                            context)
                                _arguments \
                                    "--task=[Task]:task:($agent_context_tasks)" \
                                    '--level=[Detail level]:level:(minimal compact full)' \
                                    '--list[Enumerate available context tasks]' \
                                    '--interactive[Interactive TUI picker]' \
                                    '--tui[Interactive TUI picker]'
                                ;;
                            overview)
                                _arguments '*:app dir:_files -/'
                                ;;
                            *)
                                _arguments \
                                    '--json[Machine-readable JSON output]' \
                                    '(-p --port)'{-p,--port}'[Dev server port]:port:' \
                                    '*:app dir:_files -/'
                                ;;
                        esac
                    fi
                    ;;

                migrate)
                    if (( CURRENT == 2 )); then
                        _alternative \
                            'subcommands:migrate subcommand:_describe -t migrate-subs "migrate subcommand" migrate_subs' \
                            'dirs:app dir:_files -/'
                    else
                        _arguments \
                            '(-d --database)'{-d,--database}'[Database file]:file:_files' \
                            '--json[Machine-readable JSON output]' \
                            '*:app dir:_files -/'
                    fi
                    ;;

                deploy)
                    if (( CURRENT == 2 )); then
                        _describe -t deploy-targets 'deploy target' deploy_targets
                    else
                        _files -/
                    fi
                    ;;

                doctor)
                    _arguments \
                        '--json[Machine-readable JSON output]' \
                        '--tui[Interactive terminal UI]' \
                        '--fix[Install missing Hull-managed prerequisites]'
                    ;;

                version)
                    _arguments '--json[Machine-readable JSON output]'
                    ;;

                update)
                    _arguments \
                        '--check[Check for an update without installing]' \
                        '--force[Reinstall even if version matches]' \
                        '--repo[GitHub repo]:repo:' \
                        '--repo=[GitHub repo]:repo:'
                    ;;

                tools)
                    if (( CURRENT == 3 )); then
                        _describe -t tools-verbs 'tools verb' tools_subs
                    else
                        case "$words[3]" in
                            list)
                                _arguments \
                                    '--json[Machine-readable JSON output]' \
                                    '--repo=[GitHub repo]:repo:'
                                ;;
                            install)
                                # Tool names - keep in sync with REGISTRY
                                # in src/hull/tools_install.c.
                                _arguments \
                                    '--all[Install every published tool]' \
                                    '--repo=[GitHub repo]:repo:' \
                                    '*:tool:(wamrc)'
                                ;;
                            uninstall|remove)
                                _arguments '*:tool:(wamrc)'
                                ;;
                        esac
                    fi
                    ;;

                keygen|sign-platform)
                    _files
                    ;;

                sbom)
                    _arguments \
                        '--format=[SBOM format]:format:('"${sbom_formats[@]}"')' \
                        '--json[Shortcut for --format=json]'
                    ;;

                verify-self)
                    _arguments \
                        '--manifest[Manifest file]:file:_files' \
                        '--signature[Signature file]:file:_files' \
                        '--asset[Asset name in the manifest]:asset:' \
                        '--pubkey[Override the embedded release public key]:hex:'
                    ;;

                verify-release)
                    _arguments \
                        '--pubkey[Override the embedded release public key]:hex:' \
                        '*:file:_files'
                    ;;

                sign-release)
                    _arguments \
                        '--key[Ed25519 secret key file]:file:_files' \
                        '--output[Output signature path]:file:_files' \
                        '*:file:_files'
                    ;;

                modules)
                    if (( CURRENT == 2 )); then
                        _describe -t modules-subs 'modules subcommand' modules_subs
                    else
                        case "$words[2]" in
                            list|analyze)
                                _arguments \
                                    '--json[Machine-readable JSON output]' \
                                    '*:app dir:_files -/'
                                ;;
                            available)
                                _arguments \
                                    '--json[Machine-readable JSON output]' \
                                    '--tui[Interactive picker]'
                                ;;
                            explain)
                                _arguments '*:module name:'
                                ;;
                        esac
                    fi
                    ;;
            esac
            ;;
    esac
}

_hull "$@"
