diff --git a/tests/unit/shared-heap/gen_readonly_fixtures.sh b/tests/unit/shared-heap/gen_readonly_fixtures.sh
new file mode 100755
index 00000000..23b8c17a
--- /dev/null
+++ b/tests/unit/shared-heap/gen_readonly_fixtures.sh
@@ -0,0 +1,68 @@
+#!/bin/sh
+# Hull ext: deterministic AOT fixture generator for the shared-heap read-only
+# matrix (and the baseline shared-heap fixtures). Replaces ad-hoc manual/looped
+# wamrc invocations, which silently produced stale/mismatched artifacts when the
+# wamrc build drifted from the runtime. This rule:
+#   - invokes wamrc with EXPLICIT input/output paths,
+#   - checks every exit status,
+#   - rejects a missing, zero-length, or wrong-AOT-version output,
+#   - rejects a duplicate output path within one run,
+#   - records sha256 + AOT version per artifact into fixtures.manifest,
+# and behaves identically locally and in CI (POSIX sh, no bashisms, no loops that
+# could partial-fail silently -- every wamrc call is a checked function call).
+#
+# Usage: gen_readonly_fixtures.sh <wamrc> <src_dir> <out_dir> [expected_version]
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+set -eu
+
+WAMRC="${1:?wamrc path required}"
+SRC="${2:?source .wasm dir required}"
+OUT="${3:?output dir required}"
+WANT_VER="${4:-7}"
+
+[ -x "$WAMRC" ] || { echo "FATAL: wamrc not executable: $WAMRC" >&2; exit 1; }
+[ -d "$SRC" ] || { echo "FATAL: src dir missing: $SRC" >&2; exit 1; }
+mkdir -p "$OUT"
+MANIFEST="$OUT/fixtures.manifest"
+: > "$MANIFEST"
+SEEN=""
+
+H_FLAGS="--opt-level=3 --bounds-checks=1 --enable-shared-heap"
+C_FLAGS="--opt-level=3 --bounds-checks=1 --enable-shared-chain"
+
+# Read the little-endian uint32 AOT version (bytes 4..7) of an .aot file.
+aot_version() {
+    od -An -tu1 -j4 -N4 "$1" 2>/dev/null \
+        | awk 'NF>=4{print $1 + $2*256 + $3*65536 + $4*16777216; exit}'
+}
+
+emit() { # emit <flags> <in.wasm> <out.aot>
+    _in="$SRC/$2"; _out="$OUT/$3"
+    [ -f "$_in" ] || { echo "FATAL: missing input $_in" >&2; exit 1; }
+    case " $SEEN " in *" $3 "*) echo "FATAL: duplicate output $3" >&2; exit 1;; esac
+    SEEN="$SEEN $3"
+    # shellcheck disable=SC2086
+    "$WAMRC" $1 -o "$_out" "$_in" >/dev/null 2>&1 \
+        || { echo "FATAL: wamrc failed for $3" >&2; exit 1; }
+    [ -s "$_out" ] || { echo "FATAL: $3 missing or zero-length" >&2; exit 1; }
+    _magic=$(od -An -tx1 -N4 "$_out" | tr -d ' \n')
+    [ "$_magic" = "00616f74" ] || { echo "FATAL: $3 bad AOT magic ($_magic)" >&2; exit 1; }
+    _ver=$(aot_version "$_out")
+    [ "$_ver" = "$WANT_VER" ] || { echo "FATAL: $3 AOT version $_ver != $WANT_VER" >&2; exit 1; }
+    _sha=$(shasum -a 256 "$_out" 2>/dev/null | awk '{print $1}')
+    [ -n "$_sha" ] || _sha=$(sha256sum "$_out" | awk '{print $1}')
+    printf '%s  v%s  %s\n' "$_sha" "$_ver" "$3" >> "$MANIFEST"
+}
+
+# Baseline shared-heap fixtures + the read-only matrix fixture, both modes.
+emit "$H_FLAGS" test.wasm                test.aot
+emit "$C_FLAGS" test.wasm                test_chain.aot
+emit "$H_FLAGS" test_addr_conv.wasm      test_addr_conv.aot
+emit "$C_FLAGS" test_addr_conv.wasm      test_addr_conv_chain.aot
+emit "$H_FLAGS" test_bulk_memory.wasm    test_bulk_memory.aot
+emit "$C_FLAGS" test_bulk_memory.wasm    test_bulk_memory_chain.aot
+emit "$H_FLAGS" test_readonly.wasm       test_readonly.aot
+emit "$C_FLAGS" test_readonly.wasm       test_readonly_chain.aot
+
+_n=$(wc -l < "$MANIFEST" | tr -d ' ')
+echo "OK: generated $_n AOT fixtures (all version $WANT_VER) -> $MANIFEST"
diff --git a/tests/unit/shared-heap/shared_heap_test.cc b/tests/unit/shared-heap/shared_heap_test.cc
index a66cfc68..9f437901 100644
--- a/tests/unit/shared-heap/shared_heap_test.cc
+++ b/tests/unit/shared-heap/shared_heap_test.cc
@@ -1372,3 +1372,570 @@ TEST_F(shared_heap_test, test_shared_heap_chain_addr_conv_oob)
                                              "test_preallocated", 1, argv),
                             "Exception: out of bounds memory access");
 }
+
+/*
+ * Hull ext (read-only shared-heap enforcement, interpreter).
+ *
+ * A read-only shared heap models a host-mmap'd PROT_READ span. Because Hull's
+ * interpreter build uses software bounds checks (no signal handler), a store
+ * into such a span would otherwise crash the host; the CHECK_*_STORE macros
+ * turn it into a recoverable WASM trap. These cases assert the trap fires for
+ * every write family reachable from the existing fixtures, that reads still
+ * succeed, that a writable heap is unaffected, and that a trapped invocation
+ * leaves the process able to run another. (SIMD stores, memory.copy src/dst,
+ * memory.init, explicit load-only, zero-length and boundary-crossing cases are
+ * covered by test_readonly.wasm below.)
+ */
+
+static WASMSharedHeap *
+create_readonly_heap(std::vector<uint8> &backing)
+{
+    SharedHeapInitArgs args = {};
+    args.pre_allocated_addr = backing.data();
+    args.size = (uint32)backing.size();
+    args.read_only = true;
+    return wasm_runtime_create_shared_heap(&args);
+}
+
+TEST_F(shared_heap_test, test_readonly_requires_preallocated)
+{
+    /* Detail 2: read_only is only coherent for a caller-owned pre-allocated
+     * buffer; a runtime-managed heap must stay writable. The request is
+     * rejected, not silently downgraded. */
+    SharedHeapInitArgs args = {};
+    args.size = os_getpagesize();
+    args.read_only = true; /* but no pre_allocated_addr */
+    EXPECT_EQ(nullptr, wasm_runtime_create_shared_heap(&args));
+}
+
+TEST_F(shared_heap_test, test_readonly_rejects_scalar_store_and_fill)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro_heap = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro_heap, nullptr) << "read-only pre-allocated heap should create";
+
+    uint32 start = UINT32_MAX - BUF_SIZE + 1;
+    uint32 argv[3] = {};
+
+    /* i32.store8 into a read-only heap traps. read_modify_write_8 LOADS *addr
+     * first (which must succeed) and only then STORES, so a trap here also
+     * proves the read path is unaffected. */
+    argv[0] = start;
+    argv[1] = 42;
+    EXPECT_NONFATAL_FAILURE(
+        test_shared_heap(ro_heap, "test.wasm", "read_modify_write_8", 2, argv),
+        "out of bounds memory access");
+    EXPECT_EQ(ro_buf[0], 0) << "i32.store8 mutated a read-only heap";
+
+    /* i32.store16 into a read-only heap traps. */
+    argv[0] = start;
+    argv[1] = 4242;
+    EXPECT_NONFATAL_FAILURE(
+        test_shared_heap(ro_heap, "test.wasm", "read_modify_write_16", 2, argv),
+        "out of bounds memory access");
+    EXPECT_EQ(ro_buf[0], 0) << "i32.store16 mutated a read-only heap";
+
+    /* memory.fill into a read-only destination traps. */
+    argv[0] = start;
+    argv[1] = 7;
+    argv[2] = 4;
+    EXPECT_NONFATAL_FAILURE(test_shared_heap(ro_heap, "test_bulk_memory.wasm",
+                                             "memory_fill_test", 3, argv),
+                            "out of bounds memory access");
+    EXPECT_EQ(ro_buf[0], 0) << "memory.fill mutated a read-only heap";
+}
+
+TEST_F(shared_heap_test, test_readonly_trap_recovers_writable_unaffected)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    uint32 start = UINT32_MAX - BUF_SIZE + 1;
+    uint32 argv[2] = {};
+
+    /* A store into a read-only heap traps... */
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro_heap = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro_heap, nullptr);
+    argv[0] = start;
+    argv[1] = 99;
+    EXPECT_NONFATAL_FAILURE(
+        test_shared_heap(ro_heap, "test.wasm", "read_modify_write_8", 2, argv),
+        "out of bounds memory access");
+
+    /* ...and the same process then runs another invocation to completion on a
+     * writable pre-allocated heap: the store succeeds and mutates the buffer,
+     * proving the earlier trap was recoverable and writable heaps are
+     * unaffected by the read-only path. */
+    std::vector<uint8> rw_buf(BUF_SIZE, 0);
+    SharedHeapInitArgs rw_args = {};
+    rw_args.pre_allocated_addr = rw_buf.data();
+    rw_args.size = BUF_SIZE; /* read_only defaults false */
+    WASMSharedHeap *rw_heap = wasm_runtime_create_shared_heap(&rw_args);
+    ASSERT_NE(rw_heap, nullptr);
+
+    argv[0] = start;
+    argv[1] = 77;
+    test_shared_heap(rw_heap, "test.wasm", "read_modify_write_8", 2, argv);
+    EXPECT_EQ(0u, argv[0]); /* rmw returns the original value (0) */
+    EXPECT_EQ(rw_buf[0], 77); /* the store landed */
+}
+
+/*
+ * Hull ext: the FULL interpreter read-only matrix, driven by test_readonly.wasm
+ * (built from a checked-in .wat by pinned WABT 1.0.37; see docs/wamr_patches.md).
+ * Covers every enabled store family, memory.copy/fill/init dst+src permutations,
+ * explicit load-only, zero-length semantics, and boundary/overflow fail-closed.
+ * Compiled and run in BOTH bound-check configurations (this file is built once
+ * per config: HW-bound-check default and Hull's WAMR_DISABLE_HW_BOUND_CHECK).
+ */
+#define RO_WASM "test_readonly.wasm"
+#define OOB "out of bounds memory access"
+
+static const char *const kScalarStores[] = {
+    "store_i32",    "store_i32_8",  "store_i32_16", "store_i64",   "store_i64_8",
+    "store_i64_16", "store_i64_32", "store_f32",    "store_f64",
+};
+static const char *const kSimdStores[] = {
+    "store_v128",        "store_v128_8_lane",  "store_v128_16_lane",
+    "store_v128_32_lane", "store_v128_64_lane",
+};
+
+/* Recovery probe: after a trap, a fresh module instance runs a load against the
+ * read-only heap to completion (loads are permitted), proving the process
+ * survived and another module can still be invoked. */
+static void
+recover_after_trap(WASMSharedHeap *heap, uint32 addr)
+{
+    uint32 argv[1] = { addr };
+    test_shared_heap(heap, RO_WASM, "load_i32", 1, argv);
+}
+
+static bool
+all_zero(const std::vector<uint8> &b)
+{
+    for (uint8 v : b)
+        if (v != 0)
+            return false;
+    return true;
+}
+
+TEST_F(shared_heap_test, test_readonly_scalar_store_families_trap)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 mid = UINT32_MAX - BUF_SIZE + 1 + 64;
+
+    for (const char *fn : kScalarStores) {
+        SCOPED_TRACE(fn);
+        uint32 argv[1] = { mid };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, fn, 1, argv), OOB);
+    }
+    EXPECT_TRUE(all_zero(ro_buf)) << "a scalar store mutated the read-only heap";
+    /* another module runs to completion after the scalar-trap class */
+    recover_after_trap(ro, mid);
+}
+
+TEST_F(shared_heap_test, test_readonly_simd_store_families_trap)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 mid = UINT32_MAX - BUF_SIZE + 1 + 64;
+
+    for (const char *fn : kSimdStores) {
+        SCOPED_TRACE(fn);
+        uint32 argv[1] = { mid };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, fn, 1, argv), OOB);
+    }
+    EXPECT_TRUE(all_zero(ro_buf)) << "a SIMD store mutated the read-only heap";
+    recover_after_trap(ro, mid);
+}
+
+TEST_F(shared_heap_test, test_readonly_loads_succeed_and_return_value)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    /* seed a known little-endian pattern at offset 64 */
+    ro_buf[64] = 0x11;
+    ro_buf[65] = 0x22;
+    ro_buf[66] = 0x33;
+    ro_buf[67] = 0x44;
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 mid = UINT32_MAX - BUF_SIZE + 1 + 64;
+
+    uint32 argv[1] = { mid };
+    test_shared_heap(ro, RO_WASM, "load_i32", 1, argv); /* must not trap */
+    EXPECT_EQ(argv[0], 0x44332211u) << "read-only load returned wrong value";
+}
+
+TEST_F(shared_heap_test, test_readonly_memory_copy_source_vs_dest)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    ro_buf[64] = 0xAB; /* something to read from the RO source */
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 start = UINT32_MAX - BUF_SIZE + 1;
+    uint32 mid = start + 64;
+
+    /* read-only SOURCE is permitted: copy heap -> linear memory succeeds. */
+    {
+        uint32 argv[3] = { 0 /*dst: linear*/, mid /*src: RO heap*/, 8 };
+        test_shared_heap(ro, RO_WASM, "mem_copy", 3, argv); /* must not trap */
+    }
+    /* read-only DESTINATION is rejected: copy linear -> heap traps. */
+    {
+        uint32 argv[3] = { mid /*dst: RO heap*/, 0 /*src: linear*/, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "mem_copy", 3, argv),
+                                OOB);
+    }
+    EXPECT_TRUE(all_zero(ro_buf) || ro_buf[64] == 0xAB)
+        << "memory.copy mutated the read-only destination";
+    /* precise: nothing past the seeded byte changed */
+    for (uint32 i = 0; i < BUF_SIZE; i++)
+        if (i != 64)
+            ASSERT_EQ(ro_buf[i], 0) << "copy mutated read-only byte " << i;
+    recover_after_trap(ro, mid);
+}
+
+TEST_F(shared_heap_test, test_readonly_memory_fill_and_init_trap)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 mid = UINT32_MAX - BUF_SIZE + 1 + 64;
+
+    { /* memory.fill into RO dest traps */
+        uint32 argv[2] = { mid, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "mem_fill", 2, argv),
+                                OOB);
+    }
+    { /* memory.init into RO dest traps */
+        uint32 argv[3] = { mid, 0, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "mem_init", 3, argv),
+                                OOB);
+    }
+    EXPECT_TRUE(all_zero(ro_buf)) << "fill/init mutated the read-only heap";
+    recover_after_trap(ro, mid);
+}
+
+TEST_F(shared_heap_test, test_readonly_zero_length_semantics)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 mid = UINT32_MAX - BUF_SIZE + 1 + 64;
+
+    /* zero-length at a VALID read-only address writes nothing: read-only
+     * permission alone must NOT trap (WASM bounds semantics). */
+    { uint32 a[2] = { mid, 0 };    test_shared_heap(ro, RO_WASM, "mem_fill", 2, a); }
+    { uint32 a[3] = { mid, 0, 0 }; test_shared_heap(ro, RO_WASM, "mem_copy", 3, a); }
+    { uint32 a[3] = { mid, 0, 0 }; test_shared_heap(ro, RO_WASM, "mem_init", 3, a); }
+    EXPECT_TRUE(all_zero(ro_buf)) << "zero-length op mutated the heap";
+
+    /* zero-length at an INVALID address still traps per spec (d > mem size). */
+    {
+        uint32 bad = 0x00100000; /* well past the 1-page linear memory */
+        uint32 a[2] = { bad, 0 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "mem_fill", 2, a), OOB);
+    }
+    recover_after_trap(ro, mid);
+}
+
+TEST_F(shared_heap_test, test_readonly_boundary_and_overflow_fail_closed)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> ro_buf(BUF_SIZE, 0);
+    WASMSharedHeap *ro = create_readonly_heap(ro_buf);
+    ASSERT_NE(ro, nullptr);
+    uint32 start = UINT32_MAX - BUF_SIZE + 1;
+
+    /* store straddling the START boundary (partly below the heap): 4-byte store
+     * at start-2 spans start-2..start+1 -> whole range not in heap -> trap. */
+    { uint32 a[1] = { start - 2 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "store_i32", 1, a), OOB); }
+    /* store straddling the END boundary (overflow past UINT32_MAX): 8-byte store
+     * at UINT32_MAX-3 -> range overflows -> trap. */
+    { uint32 a[1] = { UINT32_MAX - 3 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "store_i64", 1, a), OOB); }
+    /* bulk range that overflows uint32: fill 0x20 bytes at 0xFFFFFFF8 -> trap. */
+    { uint32 a[2] = { 0xFFFFFFF8u, 0x20 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(ro, RO_WASM, "mem_fill", 2, a), OOB); }
+
+    EXPECT_TRUE(all_zero(ro_buf)) << "a boundary/overflow store mutated backing";
+    recover_after_trap(ro, start + 64);
+}
+
+TEST_F(shared_heap_test, test_writable_all_operation_classes)
+{
+    uint32 BUF_SIZE = os_getpagesize();
+    std::vector<uint8> rw_buf(BUF_SIZE, 0);
+    SharedHeapInitArgs args = {};
+    args.pre_allocated_addr = rw_buf.data();
+    args.size = BUF_SIZE; /* writable (read_only defaults false) */
+    WASMSharedHeap *rw = wasm_runtime_create_shared_heap(&args);
+    ASSERT_NE(rw, nullptr);
+    uint32 start = UINT32_MAX - BUF_SIZE + 1;
+    uint32 mid = start + 64;
+
+    /* every scalar + SIMD store class runs to completion on a writable heap */
+    for (const char *fn : kScalarStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        test_shared_heap(rw, RO_WASM, fn, 1, a);
+    }
+    for (const char *fn : kSimdStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        test_shared_heap(rw, RO_WASM, fn, 1, a);
+    }
+    /* spot-check a store landed: store_i32 writes 0x11223344 (LE) at mid */
+    { uint32 a[1] = { mid }; test_shared_heap(rw, RO_WASM, "store_i32", 1, a); }
+    EXPECT_EQ(rw_buf[64], 0x44);
+    EXPECT_EQ(rw_buf[65], 0x33);
+
+    /* bulk classes on a writable heap all succeed */
+    { uint32 a[2] = { mid, 8 };    test_shared_heap(rw, RO_WASM, "mem_fill", 2, a); }
+    EXPECT_EQ(rw_buf[64], 0x55) << "writable memory.fill did not land";
+    { uint32 a[3] = { mid, 0, 8 }; test_shared_heap(rw, RO_WASM, "mem_copy", 3, a); }
+    { uint32 a[3] = { mid, 0, 8 }; test_shared_heap(rw, RO_WASM, "mem_init", 3, a); }
+    EXPECT_EQ(rw_buf[64], 'A') << "writable memory.init did not land";
+}
+
+/*
+ * Hull ext: prove the AOT version bump (6 -> 7) is enforced. A version-7
+ * artifact (the shifted AOTModuleInstanceExtra layout) loads; the SAME bytes
+ * with the version field patched back to 6 are REJECTED by this runtime -- so a
+ * stale/mismatched-layout artifact can never be executed against the new struct.
+ */
+TEST_F(shared_heap_test, test_aot_version7_enforced_version6_rejected)
+{
+    unsigned int sz = 0;
+    unsigned char *buf =
+        (unsigned char *)bh_read_file_to_buffer("test_readonly.aot", &sz);
+    ASSERT_NE(buf, nullptr);
+    ASSERT_GT(sz, 8u);
+    /* AOT file: magic (bytes 0..3) + little-endian version (bytes 4..7) */
+    ASSERT_EQ(buf[4], 7) << "fixture is not AOT version 7";
+
+    char err[192] = {};
+    /* positive control: the unpatched version-7 artifact loads */
+    wasm_module_t m7 = wasm_runtime_load(buf, sz, err, sizeof(err));
+    EXPECT_NE(m7, nullptr) << "version-7 artifact failed to load: " << err;
+    if (m7)
+        wasm_runtime_unload(m7);
+
+    /* patch version 7 -> 6 and confirm the runtime refuses it */
+    buf[4] = 6;
+    err[0] = '\0';
+    wasm_module_t m6 = wasm_runtime_load(buf, sz, err, sizeof(err));
+    EXPECT_EQ(m6, nullptr) << "a version-6 artifact was NOT rejected";
+    if (m6)
+        wasm_runtime_unload(m6);
+    else
+        EXPECT_NE(std::string(err).find("version"), std::string::npos)
+            << "rejection was not a version error: " << err;
+
+    wasm_runtime_free(buf);
+}
+
+/*
+ * Hull ext: the AOT read-only matrix, mirroring the interpreter matrix but
+ * driven by test_readonly.aot (compiled by the patched, version-7 wamrc). The
+ * AOT enforcement emits the permission branch inside app_addr_in_cache_shared_heap
+ * (reached by both cache-hit and chain-hit), dominating native-address formation.
+ */
+#define AOT_RO "test_readonly.aot"
+
+TEST_F(shared_heap_test, test_readonly_aot_scalar_simd_store_families_trap)
+{
+    uint32 BUF = os_getpagesize();
+    std::vector<uint8> ro(BUF, 0);
+    WASMSharedHeap *h = create_readonly_heap(ro);
+    ASSERT_NE(h, nullptr);
+    uint32 mid = UINT32_MAX - BUF + 1 + 64;
+
+    for (const char *fn : kScalarStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, fn, 1, a), OOB);
+    }
+    for (const char *fn : kSimdStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, fn, 1, a), OOB);
+    }
+    EXPECT_TRUE(all_zero(ro)) << "an AOT store mutated the read-only heap";
+    /* another module runs to completion after the trap class */
+    uint32 a[1] = { mid };
+    test_shared_heap(h, AOT_RO, "load_i32", 1, a);
+}
+
+TEST_F(shared_heap_test, test_readonly_aot_loads_copy_fill_init)
+{
+    uint32 BUF = os_getpagesize();
+    std::vector<uint8> ro(BUF, 0);
+    ro[64] = 0x11;
+    ro[65] = 0x22;
+    ro[66] = 0x33;
+    ro[67] = 0x44;
+    WASMSharedHeap *h = create_readonly_heap(ro);
+    ASSERT_NE(h, nullptr);
+    uint32 mid = UINT32_MAX - BUF + 1 + 64;
+
+    /* load returns the correct value (reads unaffected) */
+    {
+        uint32 a[1] = { mid };
+        test_shared_heap(h, AOT_RO, "load_i32", 1, a);
+        EXPECT_EQ(a[0], 0x44332211u);
+    }
+    /* memory.copy read-only SOURCE permitted (heap -> linear) */
+    {
+        uint32 a[3] = { 0, mid, 8 };
+        test_shared_heap(h, AOT_RO, "mem_copy", 3, a);
+    }
+    /* memory.copy read-only DEST trap */
+    {
+        uint32 a[3] = { mid, 0, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "mem_copy", 3, a),
+                                OOB);
+    }
+    /* memory.fill read-only dest trap */
+    {
+        uint32 a[2] = { mid, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "mem_fill", 2, a),
+                                OOB);
+    }
+    /* memory.init read-only dest trap */
+    {
+        uint32 a[3] = { mid, 0, 8 };
+        EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "mem_init", 3, a),
+                                OOB);
+    }
+    for (uint32 i = 0; i < BUF; i++)
+        if (i < 64 || i > 67)
+            ASSERT_EQ(ro[i], 0) << "AOT bulk mutated read-only byte " << i;
+}
+
+TEST_F(shared_heap_test, test_readonly_aot_zero_length_and_boundary)
+{
+    uint32 BUF = os_getpagesize();
+    std::vector<uint8> ro(BUF, 0);
+    WASMSharedHeap *h = create_readonly_heap(ro);
+    ASSERT_NE(h, nullptr);
+    uint32 start = UINT32_MAX - BUF + 1, mid = start + 64;
+
+    /* zero-length at a valid read-only address must NOT trap */
+    { uint32 a[2] = { mid, 0 };    test_shared_heap(h, AOT_RO, "mem_fill", 2, a); }
+    { uint32 a[3] = { mid, 0, 0 }; test_shared_heap(h, AOT_RO, "mem_copy", 3, a); }
+    { uint32 a[3] = { mid, 0, 0 }; test_shared_heap(h, AOT_RO, "mem_init", 3, a); }
+    EXPECT_TRUE(all_zero(ro)) << "zero-length AOT op mutated the heap";
+
+    /* boundary straddle + uint32 overflow fail closed, backing unchanged */
+    { uint32 a[1] = { start - 2 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "store_i32", 1, a), OOB); }
+    { uint32 a[1] = { UINT32_MAX - 3 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "store_i64", 1, a), OOB); }
+    { uint32 a[2] = { 0xFFFFFFF8u, 0x20 };
+      EXPECT_NONFATAL_FAILURE(test_shared_heap(h, AOT_RO, "mem_fill", 2, a), OOB); }
+    EXPECT_TRUE(all_zero(ro)) << "AOT boundary/overflow store mutated backing";
+}
+
+TEST_F(shared_heap_test, test_readonly_aot_writable_all_classes)
+{
+    uint32 BUF = os_getpagesize();
+    std::vector<uint8> rw(BUF, 0);
+    SharedHeapInitArgs args = {};
+    args.pre_allocated_addr = rw.data();
+    args.size = BUF; /* writable */
+    WASMSharedHeap *h = wasm_runtime_create_shared_heap(&args);
+    ASSERT_NE(h, nullptr);
+    uint32 mid = UINT32_MAX - BUF + 1 + 64;
+
+    for (const char *fn : kScalarStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        test_shared_heap(h, AOT_RO, fn, 1, a);
+    }
+    for (const char *fn : kSimdStores) {
+        SCOPED_TRACE(fn);
+        uint32 a[1] = { mid };
+        test_shared_heap(h, AOT_RO, fn, 1, a);
+    }
+    { uint32 a[1] = { mid }; test_shared_heap(h, AOT_RO, "store_i32", 1, a); }
+    EXPECT_EQ(rw[64], 0x44);
+    EXPECT_EQ(rw[65], 0x33);
+    { uint32 a[2] = { mid, 8 }; test_shared_heap(h, AOT_RO, "mem_fill", 2, a); }
+    EXPECT_EQ(rw[64], 0x55) << "AOT writable memory.fill did not land";
+    { uint32 a[3] = { mid, 0, 8 }; test_shared_heap(h, AOT_RO, "mem_copy", 3, a); }
+    { uint32 a[3] = { mid, 0, 8 }; test_shared_heap(h, AOT_RO, "mem_init", 3, a); }
+    EXPECT_EQ(rw[64], 'A') << "AOT writable memory.init did not land";
+}
+
+/*
+ * Alternating writable/read-only heaps in ONE invocation, BOTH cache directions.
+ * A chain of [writable head, read-only body]; load_then_store(rd, wr) reads rd
+ * (caching rd's heap permission) then stores to wr. If the permission cache were
+ * not updated to the STORE heap, one direction would be wrong:
+ *  - writable-cached -> read-only store MUST trap (stale writable perm would let
+ *    a read-only write through);
+ *  - read-only-cached -> writable store MUST succeed (stale read-only perm would
+ *    wrongly block a writable write).
+ */
+static void
+run_alternating_heaps(const char *fixture)
+{
+    uint32 BUF = os_getpagesize();
+    std::vector<uint8> rw(BUF, 0), ro(BUF, 0);
+    SharedHeapInitArgs a1 = {};
+    a1.pre_allocated_addr = rw.data();
+    a1.size = BUF; /* writable head */
+    WASMSharedHeap *h_rw = wasm_runtime_create_shared_heap(&a1);
+    SharedHeapInitArgs a2 = {};
+    a2.pre_allocated_addr = ro.data();
+    a2.size = BUF;
+    a2.read_only = true; /* read-only body */
+    WASMSharedHeap *h_ro = wasm_runtime_create_shared_heap(&a2);
+    ASSERT_NE(h_rw, nullptr);
+    ASSERT_NE(h_ro, nullptr);
+    WASMSharedHeap *chain = wasm_runtime_chain_shared_heaps(h_rw, h_ro);
+    ASSERT_NE(chain, nullptr);
+    uint32 rw_addr = UINT32_MAX - 2 * BUF + 1 + 64; /* head (lower) range */
+    uint32 ro_addr = UINT32_MAX - BUF + 1 + 64;     /* body (upper) range */
+
+    /* writable-cached -> read-only store: traps */
+    {
+        uint32 a[2] = { rw_addr, ro_addr };
+        EXPECT_NONFATAL_FAILURE(
+            test_shared_heap(chain, fixture, "load_then_store", 2, a), OOB);
+    }
+    EXPECT_TRUE(all_zero(ro)) << fixture << ": read-only heap mutated (w->ro)";
+
+    /* read-only-cached -> writable store: succeeds (stale read-only would block) */
+    {
+        uint32 a[2] = { ro_addr, rw_addr };
+        test_shared_heap(chain, fixture, "load_then_store", 2, a);
+    }
+    EXPECT_EQ(rw[64], 0x5a)
+        << fixture << ": writable store wrongly blocked after read-only (ro->w)";
+    EXPECT_TRUE(all_zero(ro)) << fixture << ": read-only heap mutated (ro->w)";
+}
+
+TEST_F(shared_heap_test, test_readonly_alternating_heaps_aot)
+{
+    run_alternating_heaps("test_readonly_chain.aot");
+}
+TEST_F(shared_heap_test, test_readonly_alternating_heaps_interp)
+{
+    run_alternating_heaps("test_readonly.wasm");
+}
+
+#undef AOT_RO
+#undef RO_WASM
+#undef OOB
diff --git a/tests/unit/shared-heap/wasm-apps/test_readonly.wat b/tests/unit/shared-heap/wasm-apps/test_readonly.wat
new file mode 100644
index 00000000..6f2cd150
--- /dev/null
+++ b/tests/unit/shared-heap/wasm-apps/test_readonly.wat
@@ -0,0 +1,69 @@
+;; Hull ext: comprehensive read-only shared-heap enforcement fixture.
+;;
+;; Every write family the interpreter enforcement covers, plus a load-only
+;; export and the three bulk ops (so the test can drive read-only source vs
+;; destination, zero-length, and boundary permutations). Functions take only
+;; i32 address/length params (clean argv encoding across wasm_runtime_call_wasm)
+;; and use constant store values, since the trap depends on the destination
+;; address, not the value. Built by pinned wat2wasm (WABT 1.0.37); see
+;; docs/wamr_patches.md.
+(module
+  (memory (export "memory") 1)
+
+  ;; Passive data segment for memory.init (8 bytes).
+  (data $seg "ABCDEFGH")
+
+  ;; ---- scalar stores (full width + narrow) ----
+  (func (export "store_i32") (param $p i32)
+    local.get $p (i32.const 0x11223344) i32.store)
+  (func (export "store_i32_8") (param $p i32)
+    local.get $p (i32.const 0x55) i32.store8)
+  (func (export "store_i32_16") (param $p i32)
+    local.get $p (i32.const 0x6677) i32.store16)
+  (func (export "store_i64") (param $p i32)
+    local.get $p (i64.const 0x1122334455667788) i64.store)
+  (func (export "store_i64_8") (param $p i32)
+    local.get $p (i64.const 0x99) i64.store8)
+  (func (export "store_i64_16") (param $p i32)
+    local.get $p (i64.const 0xaabb) i64.store16)
+  (func (export "store_i64_32") (param $p i32)
+    local.get $p (i64.const 0xccddeeff) i64.store32)
+  (func (export "store_f32") (param $p i32)
+    local.get $p (f32.const 1.5) f32.store)
+  (func (export "store_f64") (param $p i32)
+    local.get $p (f64.const 2.5) f64.store)
+
+  ;; ---- load-only (must succeed against a read-only heap) ----
+  (func (export "load_i32") (param $p i32) (result i32)
+    local.get $p i32.load)
+  (func (export "load_i64") (param $p i32) (result i64)
+    local.get $p i64.load)
+
+  ;; ---- read one address, then store to another: exercises the shared-heap
+  ;; permission cache in BOTH directions within one invocation (a load caches
+  ;; the read heap's permission; the following store must use the STORE heap's
+  ;; permission, not the stale cached one). ----
+  (func (export "load_then_store") (param $rd i32) (param $wr i32)
+    local.get $rd i32.load drop
+    local.get $wr (i32.const 0x5a5a5a5a) i32.store)
+
+  ;; ---- SIMD stores (full vector + every lane width) ----
+  (func (export "store_v128") (param $p i32)
+    local.get $p (v128.const i32x4 1 2 3 4) v128.store)
+  (func (export "store_v128_8_lane") (param $p i32)
+    local.get $p (v128.const i32x4 1 2 3 4) (v128.store8_lane 0))
+  (func (export "store_v128_16_lane") (param $p i32)
+    local.get $p (v128.const i32x4 1 2 3 4) (v128.store16_lane 0))
+  (func (export "store_v128_32_lane") (param $p i32)
+    local.get $p (v128.const i32x4 1 2 3 4) (v128.store32_lane 0))
+  (func (export "store_v128_64_lane") (param $p i32)
+    local.get $p (v128.const i32x4 1 2 3 4) (v128.store64_lane 0))
+
+  ;; ---- bulk ops (dst, [src], len) ----
+  (func (export "mem_fill") (param $dst i32) (param $len i32)
+    local.get $dst (i32.const 0x55) local.get $len memory.fill)
+  (func (export "mem_copy") (param $dst i32) (param $src i32) (param $len i32)
+    local.get $dst local.get $src local.get $len memory.copy)
+  (func (export "mem_init") (param $dst i32) (param $src_off i32) (param $len i32)
+    local.get $dst local.get $src_off local.get $len (memory.init $seg))
+)
