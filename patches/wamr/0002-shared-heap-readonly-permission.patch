+/*
+ * Hull ext: for a STORE, trap if the matched shared heap is read-only, emitted
+ * inside app_addr_in_cache_shared_heap BEFORE build_get_maddr_in_cache_shared_heap
+ * so the permission branch dominates native-address formation. Both the direct
+ * cache-hit and the chain-hit converge on that block, and the chain helper wrote
+ * the MATCHED heap's read_only into func_ctx->shared_heap_read_only together with
+ * base_addr_adj -- so the permission always belongs to the heap that forms the
+ * address. `bulk_len` (a runtime length) gates a zero-length bulk op out of the
+ * trap (WASM bounds semantics: no write => permission alone must not trap); pass
+ * NULL for scalar/SIMD (fixed nonzero width). On success the builder is left in a
+ * new "store permitted" block where the caller continues address formation.
+ */
+static bool
+build_shared_heap_store_ro_trap(AOTCompContext *comp_ctx,
+                                AOTFuncContext *func_ctx, LLVMValueRef bulk_len)
+{
+    LLVMValueRef ro, is_ro, cond;
+    LLVMBasicBlockRef store_ok;
+
+    if (!(ro = LLVMBuildLoad2(comp_ctx->builder, INT8_TYPE,
+                              func_ctx->shared_heap_read_only,
+                              "shared_heap_ro"))) {
+        aot_set_last_error("llvm build load failed");
+        return false;
+    }
+    if (!(is_ro = LLVMBuildICmp(comp_ctx->builder, LLVMIntNE, ro, I8_ZERO,
+                                "is_readonly"))) {
+        aot_set_last_error("llvm build icmp failed");
+        return false;
+    }
+    cond = is_ro;
+    if (bulk_len) {
+        LLVMValueRef len_nz, zero = LLVMConstNull(LLVMTypeOf(bulk_len));
+        if (!(len_nz = LLVMBuildICmp(comp_ctx->builder, LLVMIntNE, bulk_len,
+                                     zero, "len_nonzero"))) {
+            aot_set_last_error("llvm build icmp failed");
+            return false;
+        }
+        if (!(cond = LLVMBuildAnd(comp_ctx->builder, is_ro, len_nz,
+                                  "ro_store_trap"))) {
+            aot_set_last_error("llvm build and failed");
+            return false;
+        }
+    }
+    if (!(store_ok = LLVMAppendBasicBlockInContext(
+              comp_ctx->context, func_ctx->func, "shared_heap_store_ok"))) {
+        aot_set_last_error("llvm add basic block failed");
+        return false;
+    }
+    /* cond true -> out-of-bounds trap; false -> continue in store_ok */
+    if (!aot_emit_exception(comp_ctx, func_ctx,
+                            EXCE_OUT_OF_BOUNDS_MEMORY_ACCESS, true, cond,
+                            store_ok))
+        return false;
+    return true;
+}
