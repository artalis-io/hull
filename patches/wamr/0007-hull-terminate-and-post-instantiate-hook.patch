+/**
+ * Hull ext (patch 0007): a process-wide hook called around the functions an
+ * instantiation runs itself - the start function, __post_instantiate and
+ * __wasm_call_ctors - with @p entering = true just before them and false just
+ * after, both on the instantiating thread and with the new (not yet returned)
+ * instance. It lets an embedder bound that code too: a watchdog can
+ * wasm_runtime_terminate() the instance between the two calls. Not called for
+ * an instance with no such functions. NULL removes the hook.
+ */
+typedef void (*wasm_post_instantiate_hook_t)(wasm_module_inst_t module_inst,
+                                             bool entering);
+WASM_RUNTIME_API_EXTERN void
+wasm_runtime_set_post_instantiate_hook(wasm_post_instantiate_hook_t hook);
