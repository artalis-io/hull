+/* Hull ext (patch 0007): check_exception_thrown with a VOLATILE load, emitted at
+ * every loop header. Generated code otherwise looks at the exception only after
+ * a call, so a loop that makes none - `(loop br 0)` - ran forever whatever
+ * wasm_runtime_terminate() set; and a plain load would be hoisted out of the
+ * loop. Returns through the same func_return_block as a trapping call. */
+bool
+aot_compile_check_terminate(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx)
+{
+    LLVMBasicBlockRef block_curr, check_succ;
+    LLVMValueRef value, cmp;
+
+    if (!create_func_return_block(comp_ctx, func_ctx))
+        return false;
+
+    if (!(value = LLVMBuildLoad2(comp_ctx->builder, INT8_TYPE,
+                                 func_ctx->cur_exception, "term_value"))) {
+        aot_set_last_error("llvm build load failed.");
+        return false;
+    }
+    LLVMSetVolatile(value, true);
+    if (!(cmp = LLVMBuildICmp(comp_ctx->builder, LLVMIntEQ, value, I8_ZERO,
+                              "term_cmp"))) {
+        aot_set_last_error("llvm build icmp failed.");
+        return false;
+    }
+
+    if (!(check_succ = LLVMAppendBasicBlockInContext(
+              comp_ctx->context, func_ctx->func, "check_term_succ"))) {
+        aot_set_last_error("llvm add basic block failed.");
+        return false;
+    }
+
+    block_curr = LLVMGetInsertBlock(comp_ctx->builder);
+    LLVMMoveBasicBlockAfter(check_succ, block_curr);
+
+    LLVMPositionBuilderAtEnd(comp_ctx->builder, block_curr);
+    if (!LLVMBuildCondBr(comp_ctx->builder, cmp, check_succ,
+                         func_ctx->func_return_block)) {
+        aot_set_last_error("llvm build cond br failed.");
+        return false;
+    }
+
+    LLVMPositionBuilderAtEnd(comp_ctx->builder, check_succ);
+    return true;
+}
