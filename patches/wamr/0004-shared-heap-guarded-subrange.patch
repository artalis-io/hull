--- a/core/iwasm/include/wasm_export.h
+++ b/core/iwasm/include/wasm_export.h
@@ -355,6 +355,13 @@
     /* Hull ext: read-only (file-backed) heap. Default 0 = writable so every
      * existing user is unchanged. Only honored for a pre_allocated_addr heap. */
     bool read_only;
+    /* Hull ext (0004): guarded subrange (Design B). valid_size == 0 means the
+     * full reserved heap (valid_offset must be 0). A pre-allocated span sets
+     * valid_offset = addr - map_base and valid_size = len so the guest sees only
+     * [valid_offset, valid_offset + valid_size). Only honored for a
+     * pre_allocated_addr heap. */
+    uint64_t valid_offset;
+    uint64_t valid_size;
 } SharedHeapInitArgs;
 
