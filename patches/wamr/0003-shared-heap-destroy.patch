+/**
+ * Hull ext (0003): Destroy a single pre-allocated shared heap created by
+ * wasm_runtime_create_shared_heap, reclaiming WAMR's descriptor.
+ *
+ * The heap MUST be fully detached (attached to no module instance) and NOT part
+ * of any chain (neither a head with a chained body, nor a body referenced by
+ * another heap). Frees ONLY WAMR's descriptor; a pre-allocated backing buffer is
+ * owned by the caller and is left untouched. Runtime-managed heaps are not
+ * supported.
+ *
+ * @param heap the shared heap to destroy
+ * @return true iff the descriptor was unlinked and freed; false (fail-closed, no
+ *         free, no state change) if `heap` is NULL, not a currently-registered
+ *         heap (double-destroy / foreign pointer), still attached, still chained,
+ *         or runtime-managed.
+ */
+WASM_RUNTIME_API_EXTERN bool
+wasm_runtime_destroy_shared_heap(wasm_shared_heap_t heap);
+
