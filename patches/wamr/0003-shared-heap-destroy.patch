+/* Hull ext (0003): destroy a single pre-allocated shared heap.
+ *
+ * WAMR is otherwise create-only (create prepends to the process-global
+ * shared_heap_list, reclaimed only at wasm_runtime_destroy). A per-invocation
+ * span lifecycle needs to reclaim heaps, so this frees ONE descriptor, fail-
+ * closed, under shared_heap_list_lock, proving in a single pass that the pointer
+ * is (a) a live registered node -- by pointer identity, BEFORE dereferencing any
+ * field, so a double-destroy never touches freed memory -- and (b) detached
+ * (attached_count == 0) and (c) not part of any chain (no OUTGOING chain_next and
+ * no INCOMING chain_next from any node: attached_count is head-only, so the
+ * incoming-edge scan is what proves a body heap is unreferenced). Only WAMR's
+ * descriptor is freed; a pre-allocated backing buffer is the caller's and is left
+ * untouched. Runtime-managed heaps (heap_handle != NULL) are out of scope. */
+bool
+wasm_runtime_destroy_shared_heap(WASMSharedHeap *heap)
+{
+    WASMSharedHeap *cur, *pred = NULL;
+    bool found = false, has_incoming = false;
+
+    if (!heap)
+        return false;
+
+    os_mutex_lock(&shared_heap_list_lock);
+
+    /* (a) identity search: compare pointers only, never deref `heap`. Also find
+     * the unlink predecessor and any incoming chain edge in the same pass. */
+    for (cur = shared_heap_list; cur; cur = cur->next) {
+        if (cur == heap) {
+            found = true;
+            continue;
+        }
+        if (cur->next == heap)
+            pred = cur;
+        if (cur->chain_next == heap)
+            has_incoming = true;
+    }
+    if (!found) {
+        os_mutex_unlock(&shared_heap_list_lock);
+        LOG_WARNING("Shared heap to destroy is not a registered shared heap");
+        return false;
+    }
+
+    /* `heap` is a proven-live registered node -> safe to read its fields now. */
+    if (heap->heap_handle != NULL) {
+        os_mutex_unlock(&shared_heap_list_lock);
+        LOG_WARNING("Cannot destroy a runtime-managed shared heap");
+        return false;
+    }
+    if (heap->attached_count != 0) {
+        os_mutex_unlock(&shared_heap_list_lock);
+        LOG_WARNING("Cannot destroy a shared heap that is still attached");
+        return false;
+    }
+    if (heap->chain_next != NULL || has_incoming) {
+        os_mutex_unlock(&shared_heap_list_lock);
+        LOG_WARNING("Cannot destroy a shared heap that is still part of a chain");
+        return false;
+    }
+
+    /* (c) unlink + free, all before releasing the lock: there is no window where
+     * the descriptor is both eligible and still reachable via the list. */
+    if (pred)
+        pred->next = heap->next;
+    else
+        shared_heap_list = heap->next; /* heap was the list head */
+    heap->next = NULL;
+    heap->chain_next = NULL;
+    heap->base_addr = NULL;
+    heap->size = 0;
+    wasm_runtime_free(heap);
+
+    os_mutex_unlock(&shared_heap_list_lock);
+    return true;
+}
+
+/* Hull ext (0003): TEST-ONLY probe -- current shared_heap_list length. Lets a
+ * test prove reclamation keeps the list (and hence chain_shared_heaps' O(list)
+ * cost) bounded across many create/destroy cycles, rather than only checking
+ * memory at process exit. */
+uint32
+wasm_runtime_shared_heap_count(void)
+{
+    WASMSharedHeap *cur;
+    uint32 n = 0;
+
+    os_mutex_lock(&shared_heap_list_lock);
+    for (cur = shared_heap_list; cur; cur = cur->next)
+        n++;
+    os_mutex_unlock(&shared_heap_list_lock);
+    return n;
+}
