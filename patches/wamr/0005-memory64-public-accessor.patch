+/* Hull ext (0005): public read of the internal is_memory64 flag. Compiled with
+ * WAMR's own config (WASM_ENABLE_MEMORY64=1 + the internal include set), so the
+ * WASMMemoryInstance layout matches the rest of the runtime -- the caller never
+ * sees the struct. Null-safe (fail-closed): a NULL memory is not Memory64. */
+bool
+wasm_runtime_memory_is_memory64(WASMMemoryInstance *memory)
+{
+    return memory != NULL && memory->is_memory64;
+}
